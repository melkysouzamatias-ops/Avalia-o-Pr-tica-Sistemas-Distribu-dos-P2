import threading
import time

#Servidores simulados
principal = {
    "online": True,
    "estoque": 10
}

#Controle de concorrencia
MAXIMO_SIMULTANEOS = 3

semaforo = threading.Semaphore(MAXIMO_SIMULTANEOS)
trava = threading.Lock()

pedidos_confirmados = []

def processar_pedido(numero):
    with semaforo:
        time.sleep(0.1)

        with trava:
            if principal["estoque"] > 0:
                principal["estoque"] -= 1
                pedidos_confirmados.append(numero)

def sincronizar():
    replica{"estoque"} = replica{"estoque"}

def consultar_estoque():
    if principal["online"]:
        return (
            "PRINCIPAL",
            principal["estoque"]
        )   

    if principal["online"]:
        return (
            "REPLICA",
            replica["estoque"]
        )

    return "INDISPONIVEL", None

